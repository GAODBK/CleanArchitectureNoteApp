<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="#F8F9FA"
        android:gravity="center|start"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginStart="13dp"
            android:src="@drawable/circes" />

        <TextView
            android:id="@+id/departure_date_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="1月8日"
            android:textColor="#000000"
            android:textSize="20sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:id="@+id/item_llt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 航班信息部分（上半部分） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/top_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTrainNumber_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/train_number_background"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="4dp"
                    android:text="G466"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF">

                    <!-- 出发站 -->
                    <TextView
                        android:id="@+id/departure_station_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="怀化南"
                        android:textColor="#666666"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

                    <!-- 出发时间 -->
                    <TextView
                        android:id="@+id/departure_time_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11:41"
                        android:textColor="#000000"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/departure_station_item"
                        app:layout_constraintTop_toBottomOf="@id/departure_station_item" />

                    <LinearLayout
                        android:id="@+id/linearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:ignore="MissingConstraints">

                        <!-- 左边的图标 -->
                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:src="@drawable/left_icon" />

                        <!-- 分割线 -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="#4285F4" />

                        <!-- 中间的图标 -->
                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_marginHorizontal="8dp"
                            android:src="@drawable/middle_icon" />

                        <!-- 分割线 -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="#4285F4" />

                        <!-- 右边的图标 -->
                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:src="@drawable/right_icon" />

                    </LinearLayout>

                    <!-- 到达站 -->
                    <TextView
                        android:id="@+id/arrival_station_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="邵阳北"
                        android:textColor="#666666"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/departure_station_item" />

                    <!-- 到达时间 -->
                    <TextView
                        android:id="@+id/arrival_time_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:21"
                        android:textColor="#000000"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/arrival_station_item" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- 航班详细信息（下半部分） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/departure_time"
                    tools:layout_editor_absoluteX="24dp">

                    <!-- 检票口标签 -->
                    <TextView
                        android:id="@+id/tvGateLabel_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="检票口"
                        android:textColor="#999999"
                        android:textSize="14sp"
                        tools:ignore="MissingConstraints" />

                    <!-- 检票口号 -->
                    <TextView
                        android:id="@+id/tvGateNumber_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="检票口1"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvGateLabel_item"
                        app:layout_constraintStart_toEndOf="@id/tvGateLabel_item" />

                    <!-- 座位号标签 -->
                    <TextView
                        android:id="@+id/tvSeatLabel_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="座位号"
                        android:textColor="#999999"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvGateLabel_item" />

                    <!-- 座位号 -->
                    <TextView
                        android:id="@+id/tvSeatNumber_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="2车 6C 6D号"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvSeatLabel_item"
                        app:layout_constraintStart_toEndOf="@id/tvSeatLabel_item" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <!-- 提示信息 -->
                <TextView
                    android:id="@+id/tvTip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:text="信息来自高铁管家，请按计划发车时间安排出行"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
